# Copy this file to src/java/mail.properties and fill your Gmail app password locally.
smartphone.mail.host=smtp.gmail.com
smartphone.mail.port=587
smartphone.mail.user=yourgmail@gmail.com
smartphone.mail.password=your-gmail-app-password
smartphone.mail.from=yourgmail@gmail.com

# Google OAuth login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
